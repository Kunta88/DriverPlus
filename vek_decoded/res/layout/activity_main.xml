        <LinearLayout android:orientation="horizontal" android:background="@android:color/black" android:paddingLeft="8.0dp" android:paddingTop="4.0dp" android:paddingRight="8.0dp" android:paddingBottom="4.0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="12.0sp" android:textColor="@android:color/white" android:id="@id/server_status_text" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="🟢 Server connected" android:singleLine="true" android:layout_weight="1.0" />
            <TextView android:textSize="12.0sp" android:textColor="@android:color/white" android:gravity="center" android:id="@id/server_ping_text" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="Ping: -- ms" android:singleLine="true" android:layout_weight="1.0" />
            <TextView android:textSize="12.0sp" android:textColor="@android:color/white" android:gravity="end" android:id="@id/server_last_update_text" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="Last update: -- s" android:singleLine="true" android:layout_weight="1.0" />
        </LinearLayout>
        <androidx.viewpager2.widget.ViewPager2 android:id="@id/main_viewPager" android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0" />
