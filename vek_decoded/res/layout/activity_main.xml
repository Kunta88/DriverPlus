            <Button android:id="@id/toolbar_button_leave_parking" android:background="@drawable/btn_grey" android:visibility="gone" android:layout_width="0.0dp" android:text="@string/leave_all_parking" android:layout_weight="1.0" style="@style/ToolbarButton" />
