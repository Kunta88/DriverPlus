            <ImageButton android:id="@id/toolbar_button_danger" android:background="@drawable/btn_grey" android:layout_width="48.0dp" android:layout_height="match_parent" android:src="@drawable/ic_action_danger_on" android:contentDescription="@string/driver_in_danger" style="@style/ToolbarButton" />
            <ImageButton android:id="@id/toolbar_button_client_info" android:background="@drawable/btn_grey" android:visibility="gone" android:layout_width="48.0dp" android:layout_height="match_parent" android:src="@drawable/ic_baseline_person_add_36" android:contentDescription="@string/add_client_info_button" />
            <Button android:id="@id/toolbar_button_session" android:background="@drawable/btn_grey" android:visibility="gone" android:layout_width="0.0dp" android:text="@string/open_session" android:layout_weight="1.0" style="@style/ToolbarButton" />
